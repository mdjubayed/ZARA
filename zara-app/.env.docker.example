OMNIROUTE_BASE_URL=http://host.docker.internal:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=
FREELLMAPI_BASE_URL=http://host.docker.internal:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=
PROVIDER_TIMEOUT_MS=60000
