{
  "name": "zara-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:server && tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "vite preview",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "build:server": "esbuild server/app.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-server/app.cjs",
    "desktop:dev": "electron . --dev",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "electron": "^45.4.1",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.28.2": true
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.zara.assistant",
    "productName": "ZARA AI",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
