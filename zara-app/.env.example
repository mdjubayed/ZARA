# ZARA API server. FreeLLMAPI defaults to 3001, so ZARA uses 3002.
PORT=3002
NODE_ENV=development
ZARA_DATA_DIR=./data
CORS_ORIGINS=

# OmniRoute local API (default local port 20128)
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=

# FreeLLMAPI local API (default local port 3001)
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=

PROVIDER_TIMEOUT_MS=60000
